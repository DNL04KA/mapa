			<key>NSStringFormatValueTypeKey</key><string>d</string>
			<key>one</key><string>%d континент</string>
			<key>few</key><string>%d континента</string>
			<key>many</key><string>%d континентов</string>
			<key>other</key><string>%d континента</string>
		</dict>
	</dict>
